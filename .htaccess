<IfModule mod_rewrite.c>
    RewriteEngine On

    # Root front controller fallback (for Apache DocumentRoot pointing to project root)
    # Avoid rewrite loops by routing to /index.php only.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>
